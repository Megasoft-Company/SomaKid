# =============================================================================
# SOMAKID AI - Environment Variables Template
# Copy this file to .env and fill in the values
# =============================================================================

# --- API Endpoints ---
EXPO_PUBLIC_AI_ENGINE_URL=http://localhost:8000
EXPO_PUBLIC_BACKEND_URL=http://localhost:8080

# --- Application ---
EXPO_PUBLIC_APP_NAME=SOMAKID AI
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_DEFAULT_LANGUAGE=fr

# --- Features ---
EXPO_PUBLIC_ENABLE_VOICE=false
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false
EXPO_PUBLIC_MAX_IMAGE_SIZE_MB=10