{
  "expo": {
    "name": "SOMAKID AI",
    "slug": "somakid-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "somakid",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F5038"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.somakid.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SOMAKID uses the camera to scan documents and capture images for learning activities.",
        "NSMicrophoneUsageDescription": "SOMAKID uses the microphone for voice-based learning interactions.",
        "NSPhotoLibraryUsageDescription": "SOMAKID accesses your photo library to upload images for educational content."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0F5038"
      },
      "package": "ai.somakid.app",
      "versionCode": 3,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-audio",
      [
        "expo-camera",
        {
          "cameraPermission": "SOMAKID uses the camera to scan documents and capture images for learning activities.",
          "microphonePermission": "SOMAKID uses the microphone for voice-based learning interactions.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SOMAKID accesses your photo library to upload images for educational content."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "35.0.0"
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "c98022a3-56a4-4fd7-ae85-2fffe3b76965"
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#0F5038",
      "barStyle": "light-content"
    },
    "description": "AI-powered educational platform for climate resilience and biodiversity education in the DRC.",
    "githubUrl": "https://github.com/pacomeissa/SomaKid"
  }
}