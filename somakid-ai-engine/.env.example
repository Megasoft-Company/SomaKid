# =============================================================================
# SOMAKID AI Engine - Environment Variables Template
# Copy this file to .env and fill in the values
# =============================================================================

# --- Environment --------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# --- Server -------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- Google Gemini AI ---------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MAX_TOKENS=2048
GEMINI_TEMPERATURE=0.4

# --- Groq API -----------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# --- ElevenLabs API ---------------------------------------------------------
ELEVENLABS_API_KEY=sk_your_elevenlabs_api_key_here

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# --- PostgreSQL Database ------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://somakid:somakid_secret@localhost:5432/somakid_db

# --- Security -----------------------------------------------------------------
SECRET_KEY=change-this-secret-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# --- Rate Limiting ------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- Supported Languages ------------------------------------------------------
SUPPORTED_LANGUAGES=fr,ln,sw
DEFAULT_LANGUAGE=fr

# --- Business Limits ----------------------------------------------------------
MAX_IMAGE_SIZE_MB=10
MAX_QUIZ_QUESTIONS_PER_SESSION=20
MAX_CHAT_HISTORY=20
CHILD_MIN_AGE=3
CHILD_MAX_AGE=15